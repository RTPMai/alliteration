+  t.test('the same address asked two days ago is skipped; eight days ago is asked', () => {
+    t.assert(/2 days ago/.test(S.decideSkip(rec('a@b.com'), ctx({ lastSent: { 'a@b.com': new Date(T0 - 2 * DAY).toISOString() } }))));
