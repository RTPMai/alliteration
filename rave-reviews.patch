+
+  await t.test('the first run records orders already at pickup and queues none of them', async () => {
+    const w = world({ printavo: { invoices: [inv(1, PICKED, 'a@b.com'), inv(2, SHIPPED, 'c@d.com'), inv(3, OTHER, 'e@f.com')] } });
