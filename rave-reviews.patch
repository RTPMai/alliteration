+  const detect = (w, now) => { P._resetPlan(); return E.detect(w.deps, { settings: w.settings, now, deadline: Date.now() + 10000 }); };
+
+  /* ======================================================================= *
+   * THE EMAIL
+   * ======================================================================= */
+
+  t.test('Printavo status names match with the emoji and capitals ignored', () => {
