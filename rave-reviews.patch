+    const m = S.renderEmail(S.DEFAULT_SETTINGS, { first_name: 'Tony', visual_id: '54781', order_nickname: 'City Laundering Food Visitor' });
+    t.equal(m.subject, '54781 - City Laundering Food Visitor');
