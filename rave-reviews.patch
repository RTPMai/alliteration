+    };
+    return {
+      kv, store, printavo, sent, deps,
+      setSend: (fn) => { sendImpl = fn; },
+      settings: Object.assign({}, S.DEFAULT_SETTINGS, { enabled: true }, o.settings || {}),
+    };
+  }
