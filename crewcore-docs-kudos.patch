+    ids.push(record.id);
+    await setRaw(keys.kudosIndex(), ids);
+  }
+  await setRaw(keys.kudos(record.id), record);
+  return record;
+}
+
+export async function deleteKudos(id) {
+  const ids = await listKudosIds();
+  const next = ids.filter((x) => x !== id);
+  if (next.length === ids.length) return false;
+  await setRaw(keys.kudosIndex(), next);
+  await setRaw(keys.kudos(id), null);
+  return true;
+}
