+// ---- Documentation ---------------------------------------------------------
+// Issues and problems written up against an employee. Its own index, NOT
+// reviews' — see the note above validateDoc() in schema.js for why the
+// separation is the safety property rather than a tidiness preference.
+// Nothing here is ever read for a self-serve caller; api/crewcore/docs.js
+// refuses one before it calls any of these.
+
+export async function listDocIds() {
+  const ids = await getRaw(keys.docIndex());
+  return Array.isArray(ids) ? ids : [];
+}
+
+export async function getDoc(id) {
+  return getRaw(keys.doc(id));
+}
+
+export async function listDocs() {
+  const ids = await listDocIds();
+  const rows = await Promise.all(ids.map((id) => getDoc(id)));
+  // Newest first: a person's file is read to find out what happened lately.
+  return rows.filter(Boolean).sort((a, b) => String(b.date).localeCompare(String(a.date)));
+}
+
+export async function saveDoc(record) {
+  const ids = await listDocIds();
+  if (!record.id) record.id = nextId("DOC", ids);
+  if (!ids.includes(record.id)) {
+    ids.push(record.id);
+    await setRaw(keys.docIndex(), ids);
+  }
+  await setRaw(keys.doc(record.id), record);
+  return record;
+}
+
+export async function updateDoc(id, patch) {
+  const existing = await getDoc(id);
+  if (!existing) return null;
+  const merged = { ...existing, ...patch, id: existing.id, updated_at: new Date().toISOString() };
+  await setRaw(keys.doc(id), merged);
+  return merged;
+}
+
+export async function deleteDoc(id) {
+  const ids = await listDocIds();
+  const next = ids.filter((x) => x !== id);
+  if (next.length === ids.length) return false;
+  await setRaw(keys.docIndex(), next);
+  await setRaw(keys.doc(id), null);
+  return true;
+}
+
+// ---- Kudos -----------------------------------------------------------------
+// Shop-wide by design: everybody with CrewCore access reads the same feed.
+// Anyone can write one, nobody can edit one, and only the author or an admin
+// can remove one (canDeleteKudos in schema.js).
+
+export async function listKudosIds() {
+  const ids = await getRaw(keys.kudosIndex());
+  return Array.isArray(ids) ? ids : [];
+}
+
+export async function getKudos(id) {
+  return getRaw(keys.kudos(id));
+}
+
+export async function listKudos() {
+  const ids = await listKudosIds();
+  const rows = await Promise.all(ids.map((id) => getKudos(id)));
+  // Sorted on created_at, not on the index order. The index is the order
+  // things were written, which is usually the same and is not guaranteed to
+  // be once anything is deleted and re-added.
+  return rows.filter(Boolean)
+    .sort((a, b) => String(b.created_at || "").localeCompare(String(a.created_at || "")));
+}
+
+export async function saveKudos(record) {
