+// ---- Documentation (issues and problems) ---------------------------------
+//
+// Sep 2026, Ryan's call: a place to write up an issue or a problem with an
+// employee, kept alongside the review history because that is where anybody
+// would look for it, and NOT visible to the person it is about.
+//
+// WHY THIS IS ITS OWN RECORD TYPE AND ITS OWN INDEX, rather than a review
+// with a `private: true` flag on it:
+//
+// The reviews route already answers a self-serve caller with their own
+// review history. Storing documentation in the same index would make that
+// answer depend on a filter remembering to strip it, forever, in every
+// future edit to that route, the dashboard card that reads the newest
+// review, and anything that reports on reviews later. One forgotten filter
+// and a written warning is on the screen of the person it was written
+// about. There is no filter to forget here: the records live under a
+// different key, and api/crewcore/docs.js refuses a non-admin caller before
+// it reads anything at all, on every method including GET.
+//
+// The screen still shows both under Reviews, which is what was asked for.
+// Two stores, one place to read them.
+
+// What the entry is ABOUT. Deliberately separate from how formal it is:
+// "attendance" and "written warning" answer two different questions, and
+// one enum trying to answer both ends up with a row for every pairing.
+export const DOC_CATEGORIES = [
+  "Attendance", "Performance", "Conduct", "Safety", "Quality",
+  "Customer issue", "Policy", "Other",
+];
+
+// How formal it is, in escalation order. "note" is the ordinary case: most
+// of what gets written down is a thing that happened, not a warning. The
+// order is the useful part — a person's file read newest first should make
+// an escalation obvious.
+export const DOC_LEVELS = [
+  "note", "verbal warning", "written warning", "final warning", "performance plan",
+];
+
+/**
+ * Entries scoped to a person and/or a year. Same shape and same reasoning as
+ * spendsFor(): a null employeeId means everyone, a null year means every
+ * year, and an entry with an unusable date is left out of a year filter
+ * rather than quietly counted into the current one.
+ */
+export function docsFor(docs, employeeId, year) {
+  let rows = Array.isArray(docs) ? docs.filter(Boolean) : [];
+  if (employeeId) rows = rows.filter((d) => d.employee_id === employeeId);
+  if (year != null) {
+    rows = rows.filter((d) => {
+      const y = parseInt(String((d && d.date) || "").slice(0, 4), 10);
+      return Number.isFinite(y) && y === Number(year);
+    });
+  }
+  return rows;
+}
+
+/**
+ * Whether an entry is a formal step rather than a note. Used to mark a row,
+ * and shared so the list, a person's file and anything that counts later all
+ * agree on what "formal" means. Same pattern as isOverStipend().
+ */
+export function isFormalDoc(doc) {
+  const level = String((doc && doc.level) || "note").trim().toLowerCase();
+  return DOC_LEVELS.includes(level) && level !== "note";
+}
+
+export function validateDoc(input, { partial = false } = {}) {
+  const errors = [];
+  const rec = {};
+
+  if (!partial && !input.employee_id) errors.push("employee_id is required");
+  else if (input.employee_id !== undefined) rec.employee_id = String(input.employee_id);
+
+  if (!partial && !input.date) errors.push("date is required");
+  else if (input.date !== undefined) rec.date = String(input.date || "");
+
+  // A one-line heading. Required, because a list of entries with no headings
+  // is a list nobody can scan, and the whole point of the file is being able
+  // to read it back later.
+  if (input.summary !== undefined) {
+    const s = String(input.summary || "").trim();
+    if (!s && !partial) errors.push("summary is required");
+    else if (!s && partial) errors.push("summary cannot be emptied");
+    else rec.summary = s;
+  } else if (!partial) {
+    errors.push("summary is required");
+  }
+
+  if (input.category !== undefined) {
+    if (input.category && !DOC_CATEGORIES.includes(input.category)) {
+      errors.push(`category must be one of: ${DOC_CATEGORIES.join(", ")}`);
+    } else {
+      rec.category = input.category || "Other";
+    }
+  } else if (!partial) {
+    rec.category = "Other";
+  }
+
+  if (input.level !== undefined) {
+    if (input.level && !DOC_LEVELS.includes(input.level)) {
+      errors.push(`level must be one of: ${DOC_LEVELS.join(", ")}`);
+    } else {
+      rec.level = input.level || "note";
+    }
+  } else if (!partial) {
+    rec.level = "note";
+  }
+
+  if (input.details !== undefined) rec.details = String(input.details || "").trim();
+  else if (!partial) rec.details = "";
+
+  if (input.action_taken !== undefined) rec.action_taken = String(input.action_taken || "").trim();
+  else if (!partial) rec.action_taken = "";
+
+  // Who else was in the room. Free text rather than a picker: a customer, a
+  // temp, or somebody's parent is not on the roster, and a field that can
+  // only hold employees would get left blank instead.
+  if (input.others_present !== undefined) rec.others_present = String(input.others_present || "").trim();
+  else if (!partial) rec.others_present = "";
+
+  if (input.follow_up_date !== undefined) rec.follow_up_date = String(input.follow_up_date || "");
+  else if (!partial) rec.follow_up_date = "";
+
+  if (errors.length) return { ok: false, errors };
+  return { ok: true, record: rec };
+}
+
+// ---- Kudos ----------------------------------------------------------------
+//
+// Sep 2026, Ryan's call: a way to hand out credit, either from a manager or
+// between employees. The mirror image of documentation in every respect that
+// matters:
+//
+//   * Documentation is admin-write, admin-read. Kudos is anyone-write,
+//     everyone-read. Praise that only the two people involved can see is a
+//     private message, not kudos.
+//   * Nobody can give themselves kudos. Refused on the server, the same way
+//     reports_to refuses self-reference, rather than left to the screen not
+//     offering your own name in the picker.
+//   * There is no edit. A kudos is two lines somebody wrote about a
+//     colleague; an edit history on it is heavier than the thing itself. If
+//     it is wrong, the author or an admin deletes it and it can be written
+//     again.
+
+export const KUDOS_TAGS = [
+  "Teamwork", "Went the extra mile", "Quality work", "Customer save",
+  "Safety", "Attitude", "Training someone",
+];
+
+export const KUDOS_MAX_LENGTH = 600;
+
+export function validateKudos(input) {
+  const errors = [];
+  const rec = {};
+
+  if (!input || !input.to_employee_id) errors.push("to_employee_id is required");
+  else rec.to_employee_id = String(input.to_employee_id);
+
+  const msg = String((input && input.message) || "").trim();
+  if (!msg) errors.push("message is required");
+  else if (msg.length > KUDOS_MAX_LENGTH) {
+    errors.push(`message must be ${KUDOS_MAX_LENGTH} characters or fewer`);
+  } else {
+    rec.message = msg;
+  }
+
+  if (input && input.tag !== undefined && input.tag !== null && input.tag !== "") {
+    if (!KUDOS_TAGS.includes(input.tag)) {
+      errors.push(`tag must be one of: ${KUDOS_TAGS.join(", ")}`);
+    } else {
+      rec.tag = input.tag;
+    }
+  } else {
+    rec.tag = "";
+  }
+
+  if (errors.length) return { ok: false, errors };
+  return { ok: true, record: rec };
+}
+
+/** The calendar year a kudos was written, or null if its stamp is unusable. */
+export function kudosYear(k) {
+  const y = parseInt(String((k && k.created_at) || "").slice(0, 4), 10);
+  return Number.isFinite(y) ? y : null;
+}
+
+/**
+ * Kudos scoped by who received them, who gave them, and/or which year. Every
+ * filter is optional; passing nothing back gives the whole feed. One reader
+ * for the feed, the "for me" tab, the dashboard count and the tests, so a
+ * count on one screen cannot disagree with the list on another.
+ */
+export function kudosFor(list, { to = null, from = null, year = null } = {}) {
+  let rows = Array.isArray(list) ? list.filter(Boolean) : [];
+  if (to) rows = rows.filter((k) => k.to_employee_id === to);
+  if (from) rows = rows.filter((k) => k.from_employee_id === from);
+  if (year != null) rows = rows.filter((k) => kudosYear(k) === Number(year));
+  return rows;
+}
+
+/**
+ * Who may remove a kudos: the person who wrote it, or a CrewCore admin.
+ *
+ * NOT the recipient. Somebody being thanked in front of the shop should not
+ * be able to quietly delete the record of it, and an unwanted one is a
+ * conversation with an admin rather than a delete button.
+ *
+ * The comparison is on the author's USERNAME, not their employee id, so it
+ * still works for an admin account with no employee record of its own.
+ */
+export function canDeleteKudos(kudos, { username, isAdmin } = {}) {
+  if (!kudos) return false;
+  if (isAdmin === true) return true;
+  const author = norm(kudos.from_username);
+  const caller = norm(username);
+  return !!author && author === caller;
+}
