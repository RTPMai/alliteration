{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
"api/health.js": {
      "includeFiles": "{lib,js,css,apps,vendor}/**"
    }
  },
  "crons": [
    {
      "path": "/api/printavo-sync?mode=incremental",
      "schedule": "50 10 * * *"
    },
    {
      "path": "/api/printavo-sync?mode=ops",
      "schedule": "0 11 * * *"
    }
  ],
  "headers": [
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/apps/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/item/:id",
      "destination": "/item.html"
    },
    {
      "source": "/scan/:id",
      "destination": "/scan.html"
    }
  ]
}
